configuration {
    modi: "drun";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    drun-display-format: "{name}";
    font: "JetBrainsMono Nerd Font 13";
}

@theme "~/.cache/wal/colors-rofi-dark"

* {
    background-color: transparent;
    text-color:        @foreground;
    border-color:       @selected-normal-background;
}

window {
    background-color: rgba(15, 15, 22, 0.32);
    border:            0px solid;
    border-color:      @selected-normal-background;
    border-radius:     24px;
    width:             480px;
    padding:           16px;

}

inputbar {
    background-color: rgba(255, 255, 255, 0.06);
    border:             1px solid;
    border-color:       rgba(255, 255, 255, 0.16);
    border-radius:      14px;
    padding:            12px 16px;
    margin:             0 0 10px 0;
    children:           [ "prompt", "entry" ];
}

prompt {
    text-color:  @selected-normal-background;
    padding:     0 10px 0 0;
    font:        "JetBrainsMono Nerd Font Bold 13";
}

entry {
    background-color: transparent;
    placeholder:        "Search...";
    placeholder-color:  rgba(255, 255, 255, 0.35);
    text-color:         @foreground;
}

listview {
    background-color: transparent;
    lines:              8;
    scrollbar:           false;
    spacing:             4px;
    fixed-height:        false;
}

element {
    background-color: transparent;
    border-radius:      12px;
    padding:            9px 12px;
    spacing:            12px;
}

element normal.normal {
    text-color: @foreground;
}

element selected {
    background-color: @selected-normal-background;
    text-color:         @selected-normal-foreground;
    border:             1px solid;
    border-color:       rgba(255, 255, 255, 0.28);
    border-radius:      12px;
}

element-icon {
    background-color: transparent;
    size:                24px;
    vertical-align:      0.5;
}

element-text {
    background-color: transparent;
    text-color:         inherit;
    vertical-align:      0.5;
}
